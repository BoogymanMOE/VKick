       {/* px-[var(--space-page-x)] aligns the header's gutters with the page below
           and pb-4 gives more breathing room from the content underneath. */}
-      <div className="mx-auto flex w-full max-w-[560px] items-center gap-3 px-[var(--space-page-x,16px)] pb-4 pt-2">
+      <div className="mx-auto flex w-full max-w-[var(--app-max-width,768px)] items-center gap-3 px-[var(--space-page-x,16px)] pb-4 pt-2">
         {back ? (
           <button
             type="button"
diff --git a/src/pages/Login.tsx b/src/pages/Login.tsx
index 351f8a7..fd50527 100644
--- a/src/pages/Login.tsx
+++ b/src/pages/Login.tsx
@@ -89,13 +89,13 @@ export default function Login() {
   return (
     <div className="floodlight flex min-h-[100svh] flex-col">
       <header className="pad-safe-top">
-        <div className="mx-auto flex w-full max-w-[560px] justify-end px-[var(--space-page-x,16px)] py-3">
+        <div className="mx-auto flex w-full max-w-[var(--app-max-width,768px)] justify-end px-[var(--space-page-x,16px)] py-3">
           <LanguageToggle />
         </div>
       </header>
 
       <main
-        className="mx-auto flex w-full max-w-[560px] flex-1 flex-col justify-center px-5"
+        className="mx-auto flex w-full max-w-[var(--app-max-width,768px)] flex-1 flex-col justify-center px-5"
         style={{ paddingBottom: "calc(40px + max(var(--safe-bottom, env(safe-area-inset-bottom, 0px)), 8px))" }}
       >
         {/* Hero: the mark over the wordmark, over the floodlit wash. */}
diff --git a/tokens.css b/tokens.css
index 771ed42..45499cc 100644
--- a/tokens.css
+++ b/tokens.css
@@ -56,6 +56,8 @@
      16px from each edge on a 360px webview is the modern mobile norm; the
      previous 12px (px-3) read as cramped. */
   --space-page-x: 16px;
+  /* App content max-width — caps how wide the centered content column can grow on tablets, desktop Telegram, and Android's expanded Mini-App view. 560px left 20–40px empty bands on each side of those wider viewports. 768px fills any reasonable phone or tablet-portrait while still capping cards on truly wide displays. The header bar, body, and tab bar all read this so they align as one column. */
+  --app-max-width: 768px;
 
   /* Vertical spacing scale — section breaks, card stacks, group gaps.
      Page gutter is --space-page-x (16px, horizontal). These are vertical. */
