# dependencies
node_modules/

# build output
dist/
dist-ssr/
dist-server/

# typescript incremental build info
*.tsbuildinfo

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (keep the example)
.env
.env.*
!.env.example

# local sqlite database (root-level only)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm
# nightly DB snapshots pushed off-site as git backups — re-include them
!backups/*.db

# keep static assets that live in data/ folders
!src/data/logos.json

# local scratch dirs (ui screenshots, temp files)
.tmp/
.ui-shots/
# generated share folder: screenshots of every screen + the code document
# (scripts/pages-demo.mjs, scripts/pages-code.mjs). Keep it ignored like the
# other screenshot output; delete the line if you want to commit the album.
demo/

# exported git-history bundle from the legacy nested repo
*.bundle

# editors / OS
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# vite
.vite/
.ui-shots
