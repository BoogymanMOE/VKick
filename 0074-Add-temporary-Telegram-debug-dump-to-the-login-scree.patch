From 74a7e9b1529944cab1293da5558ecc7e64d561aa Mon Sep 17 00:00:00 2001
From: verkur46 <mohamadrezasahami1999@gmail.com>
Date: Tue, 13 Oct 2026 12:29:40 +0330
Subject: [PATCH 074/230] Add temporary Telegram debug dump to the login screen
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Users in Iran see `[auth:guest] initData=no`, but it is unclear whether
the SDK is blocked, the URL fallback misfired, or Telegram sent nothing.
Render what the client can see (URL parts, the Telegram global, SDK
initData and the captured fallback) so the next bug report is diagnosable
without a remote debugger.

🤖 Generated with Codebuff
Co-Authored-By: Codebuff <noreply@codebuff.com>
---
 src/pages/Login.tsx | 45 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/src/pages/Login.tsx b/src/pages/Login.tsx
index d47d154..4e63e0d 100644
--- a/src/pages/Login.tsx
+++ b/src/pages/Login.tsx
@@ -6,8 +6,52 @@ import { useAuth } from "../hooks/authContext";
 import { useI18n } from "../i18n/context";
 import { serverErrorKey } from "../lib/api";
 import { isTelegram, haptic, telegramDisplayName } from "../lib/telegram";
+import { capturedTelegramInitData } from "../lib/telegramUrl";
 import type { StringKey } from "../i18n/strings";
 
+/**
+ * TEMPORARY debug aid — remove once the Iran initData/URL-fallback issue is
+ * resolved. Dumps what the client can actually see of Telegram's launch data so
+ * we can compare it against the server's `[auth:guest] initData=no` log.
+ */
+function TelegramDebugDump() {
+  const [dump, setDump] = useState("");
+  useEffect(() => {
+    setDump(
+      JSON.stringify(
+        {
+          href: window.location.href,
+          hash: window.location.hash,
+          search: window.location.search,
+          telegramGlobal: window.Telegram ? "exists" : "undefined",
+          initData: window.Telegram?.WebApp?.initData ?? null,
+          captured: capturedTelegramInitData(),
+        },
+        null,
+        2,
+      ),
+    );
+  }, []);
+  return (
+    <pre
+      style={{
+        margin: 0,
+        padding: 12,
+        background: "#ff0000",
+        color: "#ffff00",
+        fontSize: 12,
+        fontWeight: "bold",
+        whiteSpace: "pre-wrap",
+        wordBreak: "break-all",
+        zIndex: 99999,
+        position: "relative",
+      }}
+    >
+      {"TELEGRAM DEBUG\n" + dump}
+    </pre>
+  );
+}
+
 /**
  * The entry screen. "Enter" silently creates (or reuses) an account — inside
  * Telegram that's the Telegram identity, on the web a persistent guest
@@ -88,6 +132,7 @@ export default function Login() {
 
   return (
     <div className="floodlight flex min-h-[100svh] flex-col">
+      <TelegramDebugDump />
       <header className="pad-safe-top">
         <div className="mx-auto flex w-full max-w-[560px] justify-end px-3 py-2">
           <LanguageToggle />
-- 
