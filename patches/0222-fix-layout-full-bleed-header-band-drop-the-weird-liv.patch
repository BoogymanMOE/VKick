From fbb9c914bed44d33049a19b719299a92cae664c0 Mon Sep 17 00:00:00 2001
From: verkur46 <mohamadrezasahami1999@gmail.com>
Date: Sat, 24 Oct 2026 19:40:15 +0330
Subject: [PATCH 222/230] fix(layout): full-bleed header band, drop the weird
 live-group hairline Two symptoms from the user's 394px screenshot (Telegram
 Android, FA feed):
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

1. The header band (refresh + calendar + matchday title + date) was inset   16px on each side — its background and bottom hairline did not span to
   the screen edges, so the header read as a floating rectangle while the
   tab bar below it was full-bleed. Different edge rules on the same screen
   made the sides look cropped.

   Root cause: AppShell's <main> has px-[var(--space-page-x,16px)] which
   insets ALL its children, including <TopBar>. TopBar's <header> had
   border-b border-line and bg-base/95 meant to be full-bleed, but main's
   padding clipped the border to the inset rectangle.

   Fix: TopBar's <header> now also uses -mx-[var(--space-page-x,16px)] to
   break out of main's padding. The header's background and bottom hairline
   now span 0 to viewport width on phones (and the centered 768px column
   on wide screens, matching the rest of the content). The inner row keeps
   px-[var(--space-page-x,16px)] so the title and action buttons stay at
   the gutter.

2. A weird horizontal line appeared under the date strip — most visible
   next to the 'زنده' (Live) group header because that is where the user's
   eye was drawn, but the line was actually painted under EVERY group
   header on the feed (live, halftime, scheduled).

   Root cause: GroupHeader in Matches.tsx had border-b border-line plus
   -mx-[var(--space-page-x,16px)] (intended to make the title full-bleed),
   but that turned the bottom border into a full-width horizontal line
   stretched across the screen. There was also a typo px-[var(--space-page-x,16x)]
   ('16x' instead of '16px') that produced an invalid CSS value, dropping
   the right padding to 0 and pushing the count chip to the edge. Two
   empty <span> 'spacers' with text-[8px] and w-full for the live/gold
   tones broke the 2-column flex layout (title, spacer, chip = 3 elements
   when only 2 were intended).

   Fix: removed the border-b border-line (no full-bleed line under group
   headers), removed the -mx- trick, removed the broken padding, removed
   the empty spacer spans. Bumped mb-2 -> mb-3 so the header still has
   breathing room from the first card without the bottom border.

Verified locally: tsc -b, tsc -p tsconfig.server.json, vite build, eslint, npm test — all green. No new dependencies, no i18n changes, no schema changes.
---
 src/components/TopBar.tsx | 9 ++++++++-
 src/pages/Matches.tsx     | 7 +------
 2 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/src/components/TopBar.tsx b/src/components/TopBar.tsx
index 61ce29a..b3d2350 100644
--- a/src/components/TopBar.tsx
+++ b/src/components/TopBar.tsx
@@ -31,7 +31,14 @@ export function TopBar({
     // No backdrop blur: the bar is 95% opaque, so the blur was invisible while
     // still forcing a full-width backdrop read on every scroll frame — exactly
     // the cost the low-end Android target can't afford.
-    <header className="pad-safe-top sticky top-0 z-20 border-b border-line bg-base/95">
+    // Full-bleed BAND on phones (<480px): the header renders inside <main>'s
+    // page gutter, whose padding inset the band's background + hairline from
+    // the screen edge — the floating-inset rectangle that read as "cropped
+    // sides". The -mx- breaks the header out of its parent's page-gutter padding
+    // so the header background and its bottom hairline run full-bleed (left = 0 to
+    // right = viewport width), while the inner row keeps the gutter.
+    // ≥480px keeps today's inset-within-column look.
+    <header className="pad-safe-top sticky top-0 z-20 border-b border-line bg-base/95 -mx-[var(--space-page-x,16px)]">
       {/* px-[var(--space-page-x)] aligns the header's gutters with the page below
           and pb-4 gives more breathing room from the content underneath. */}
       <div className="mx-auto flex w-full max-w-[var(--app-max-width,768px)] items-center gap-3 px-[var(--space-page-x,16px)] pb-4 pt-2">
diff --git a/src/pages/Matches.tsx b/src/pages/Matches.tsx
index f17e0b3..e0856fe 100644
--- a/src/pages/Matches.tsx
+++ b/src/pages/Matches.tsx
@@ -91,7 +91,7 @@ function feedRange(lang: "en" | "fa"): { from: string; to: string } {
 
 function GroupHeader({ id, label, count, tone }: { id: string; label: string; count: number; tone: "live" | "gold" | "muted" }) {
   return (
-    <div className="mb-2 flex items-baseline justify-between gap-3 border-b border-line pb-2 -mx-[var(--space-page-x,16px)] px-[var(--space-page-x,16x)]">
+    <div className="mb-3 flex items-baseline gap-2">
       <h2
         id={id}
         className={cx(
@@ -101,11 +101,6 @@ function GroupHeader({ id, label, count, tone }: { id: string; label: string; co
       >
         {label}
       </h2>
-      {tone === "live" ? (
-        <span className="inline-flex min-h-4 w-full rounded-full bg-volt/15 text-volt text-[8px] opacity-50"/>
-      ) : tone === "gold" ? (
-        <span className="inline-flex min-h-4 w-full rounded-full bg-gold/15 text-gold text-[8px] opacity-50"/>
-      ) : null}
       <Chip tone={tone}>
         <Num>{count}</Num>
       </Chip>
