-    assert.ok(Number.isFinite(m.lx) && m.lx >= 0 && m.lx <= 1, `lx in range, got ${m.lx}`);
-    assert.ok(Number.isFinite(m.ly) && m.ly >= 0 && m.ly <= 1, `ly in range, got ${m.ly}`);
