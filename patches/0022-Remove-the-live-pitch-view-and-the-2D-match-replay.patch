-/** No usable formation keeps the old flat-line fallback, never a blank pitch. */
-function testLineupSlotsFallback(): void {
-  const lineup = {
-    formation: "",
-    coach: "",
-    subs: [],
-    starters: [p("gk", "GK", 1), p("d1", "DEF", 2), p("d2", "DEF", 3), p("m1", "MID", 4), p("f1", "FWD", 9)],
