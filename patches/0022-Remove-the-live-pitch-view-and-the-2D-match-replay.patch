-  for (let i = 0; i < script.length - 1; i += 1) {
-    const a = script[i];
-    const b = script[i + 1];
-    if (minute < b.minute) {
-      const t = (minute - a.minute) / (b.minute - a.minute);
-      return a.home + (b.home - a.home) * t;
