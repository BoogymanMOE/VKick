 src/i18n/strings.ts | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/src/i18n/strings.ts b/src/i18n/strings.ts
index bbd540a..ecf2ace 100644
--- a/src/i18n/strings.ts
+++ b/src/i18n/strings.ts
@@ -602,13 +602,13 @@ export const strings = {
     "matches.otherMatches": "سایر مسابقات",
     "table.view.tables": "جدول‌ها",
     "table.view.browse": "مرور",
-    "dates.day.mon": "دو",
-    "dates.day.tue": "سه",
-    "dates.day.wed": "چه",
-    "dates.day.thu": "پن",
-    "dates.day.fri": "جمع",
-    "dates.day.sat": "شن",
-    "dates.day.sun": "یک",
+    "dates.day.mon": "د",
+    "dates.day.tue": "س",
+    "dates.day.wed": "چ",
+    "dates.day.thu": "پ",
+    "dates.day.fri": "ج",
+    "dates.day.sat": "ش",
+    "dates.day.sun": "ی",
     "dates.today": "امروز",
     "dates.yesterday": "دیروز",
     "dates.tomorrow": "فردا",
