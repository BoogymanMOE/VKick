+  /* Day-swap: fade + slight rise when the selected day changes. Re-mounted via
+     a key on the feed wrapper in Matches.tsx, so the animation replays on every
+     day change without resetting scroll position. */
+  .day-swap {
+    animation: day-swap var(--t-std) var(--ease-out) both;
+  }
+  @keyframes day-swap {
+    from {
+      opacity: 0;
+      transform: translateY(4px);
+    }
+    to {
+      opacity: 1;
+      transform: none;
+    }
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .day-swap {
+      animation-duration: 1ms;
+    }
+  }
