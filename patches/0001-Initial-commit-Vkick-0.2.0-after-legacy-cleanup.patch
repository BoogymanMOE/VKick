+}
+
+/** Roster stats: minutes derivation and stat extraction. */
+function testRosters() {
+  const json = {
+    rosters: [
+      {
+        homeAway: "home",
+        team: { id: "359" },
+        formation: "4-3-3",
+        roster: [
+          {
+            starter: true,
+            jersey: 10,
+            athlete: {
