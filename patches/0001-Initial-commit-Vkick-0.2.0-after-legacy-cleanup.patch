+      <div
+        className="mt-3 grid grid-cols-3 gap-1 rounded-full border border-line bg-surface p-1"
+        role="tablist"
+      >
+        {(
+          [
+            ["all", "browse.all"],
+            ["league", "browse.leagues"],
+            ["cup", "browse.cups"],
+          ] as const
