+    CREATE INDEX IF NOT EXISTS idx_predictions_match ON predictions(match_id);
+
+    CREATE TABLE IF NOT EXISTS crowd_ratings (
+      id         INTEGER PRIMARY KEY AUTOINCREMENT,
