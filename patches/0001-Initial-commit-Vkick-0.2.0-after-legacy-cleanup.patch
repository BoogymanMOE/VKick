+             the running shot share — the "who's on top" read without fake
+             player dots. Pure SVG paint; no layout cost. */
+          pressure > 0 ? (
+            <ellipse
+              cx={territoryCx}
+              cy={territoryCy}
+              rx={64 + pressure * 46}
+              ry={40 + pressure * 22}
+              fill="url(#lp-territory)"
