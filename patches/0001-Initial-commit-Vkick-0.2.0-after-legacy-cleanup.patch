+       th.short_name AS home_short, ta.short_name AS away_short
+     FROM predictions p
+     JOIN matches m ON m.id = p.match_id
+     JOIN teams th ON th.id = m.home_team_id
+     JOIN teams ta ON ta.id = m.away_team_id
