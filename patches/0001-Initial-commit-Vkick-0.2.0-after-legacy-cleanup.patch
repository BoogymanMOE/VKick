+          <button
+            key={value}
+            type="button"
+            role="tab"
+            aria-selected={filter === value}
+            onClick={() => {
+              haptic("light");
+              setFilter(value);
+            }}
+            className={cx(
+              "min-h-11 rounded-full text-xs font-bold transition-colors duration-[var(--t-fast)]",
+              filter === value ? "bg-elevated text-volt" : "text-ink-2 hover:text-ink",
