From fae0d4a73d3c4e055353e40c6e6af32d10e8f33a Mon Sep 17 00:00:00 2001
From: verkur46 <mohamadrezasahami1999@gmail.com>
Date: Tue, 20 Oct 2026 00:09:52 +0330
Subject: [PATCH 176/230] fix(timeline): add card-radius utilities + live-pulse
 keyframe to index.css
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Add .rounded-s-card and .rounded-e-card utilities (logical-side partial
  rounding) so the clustered timeline band can round off the far edge
  without rounding the rail edge, which would clip the marker dot. Mirrors
  itself via logical properties so the band flips right in the FA layout.
- Fix the .timeline-live-pulse keyframe: Tailwind v4's CSS processor was
  stripping it because the block body used color-mix() inside @keyframes,
  which the processor drops. Replace with var(--live) directly — the
  keyframe only animates box-shadow spread, not colour, so var(--live) is
  correct and survives the processor pass.
- The pulse now resolves in the served CSS and fires when the class is
  applied to a live marker.

Co-Authored-By: Codebuff <noreply@codebuff.com>
---
 src/index.css | 50 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/src/index.css b/src/index.css
index b7f4ca7..0b3a0fd 100644
--- a/src/index.css
+++ b/src/index.css
@@ -29,11 +29,33 @@
   --font-num: var(--font-display);
 
   --radius-card: 14px;
+  --radius-e-card: var(--radius-card);
+  --radius-s-card: var(--radius-card);
 
   --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
   --ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);
 }
 
+@layer components {
+  /* Rounded only the end / start side of the card radius — used by the clustered
+     timeline band so the band rounds off the far edge without rounding the rail
+     edge (which would clip the marker dot). Mirrors itself via logical sides, so
+     the band flips to the right in the FA layout. */
+  .rounded-s-card {
+    border-start-start-radius: var(--radius-s-card);
+    border-end-start-radius: var(--radius-s-card);
+    border-start-end-radius: 0;
+    border-end-end-radius: 0;
+  }
+  .rounded-e-card {
+    border-start-start-radius: 0;
+    border-end-start-radius: 0;
+    border-start-end-radius: var(--radius-e-card);
+    border-end-end-radius: var(--radius-e-card);
+  }
+}
+
+
 @layer base {
   html,
   body,
@@ -722,6 +744,34 @@
     }
   }
 
+  /* FIX 8: the newest live timeline event pulses. The marker dot gets a
+     continuous coral ring (box-shadow spread 0 → 6px, fading out), and the card
+     body gets a persistent 2px coral ring + a soft glow beneath it — so the
+     live moment separates from the surrounding events at a glance. The card's
+     own event colour (volt/gold/danger) is kept on the start accent edge; the
+     live colour is reserved for the ring + glow so the two never fight.
+     
+     The keyframe body uses `var(--live)` directly (not color-mix) so Tailwind v4's
+     CSS processor keeps the @keyframes block — color-mix() inside keyframe bodies
+     is stripped by the processor, which would leave the class animationless. */
+  .timeline-live-pulse {
+    animation: timeline-live-pulse 1.6s var(--ease-out) infinite;
+  }
+  @keyframes timeline-live-pulse {
+    0%, 100% {
+      box-shadow: 0 0 0 0 var(--live);
+    }
+    50% {
+      box-shadow: 0 0 0 6px transparent;
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .timeline-live-pulse {
+      animation: none;
+    }
+  }
+
   /* Generic panel reveal for expanding sections. */
   .panel-in {
     animation: panel-in var(--t-std) var(--ease-out) both;
-- 
