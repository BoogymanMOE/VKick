diff --git a/index.html b/index.html
index ea438bd..7241239 100644
--- a/index.html
+++ b/index.html
@@ -110,25 +110,56 @@
     <!-- A-ADS (Anonymous Ads) unit, served as RAW HTML on purpose: the A-ADS
          verifier does not run JavaScript, so an ad drawn by the SPA is invisible
          to it ("Not found"). It is the initial document's own markup, and no
-         environment switch gates it — editing this block is the only way to turn it off. -->
+         environment switch gates it — editing this block is the only way to turn it off.
+
+         The slot is `position: fixed` at the very bottom of the viewport with a
+         reserved height (see --ad-slot-h in tokens.css). The TabBar sits ABOVE
+         this slot (its sticky bottom offsets by the same height) and the main
+         content's bottom padding accounts for both, so the ad never overlaps
+         content or the tab bar, and A-ADS sees a fully visible unit. -->
     <div
       id="a-ads"
-      style="margin: 20px auto; max-width: 468px; min-height: 100px; position: relative; z-index: 1"
+      style="
+        position: fixed;
+        bottom: 0;
+        left: 0;
+        right: 0;
+        z-index: 5;
+        height: var(--ad-slot-h, 100px);
+        background: var(--bg-base, #081613);
+        border-top: 1px solid var(--border-subtle, #1e3b34);
+        display: flex;
+        align-items: center;
+        justify-content: center;
+        padding: 8px 8px max(env(safe-area-inset-bottom), 8px);
+      "
     >
-      <iframe
-        data-aa="2458182"
-        src="//acceptable.a-ads.com/2458182/?size=Adaptive"
+      <div
         style="
-          border: 0;
-          padding: 0;
-          overflow: hidden;
-          display: block;
-          margin: auto;
+          max-width: 468px;
           width: 100%;
-          height: auto;
+          height: 100%;
+          display: flex;
+          align-items: center;
+          justify-content: center;
+          overflow: hidden;
         "
-        title="Advertisement"
-      ></iframe>
+      >
+        <iframe
+          data-aa="2458182"
+          src="//acceptable.a-ads.com/2458182/?size=Adaptive"
+          style="
+            border: 0;
+            padding: 0;
+            margin: 0;
+            display: block;
+            width: 100%;
+            height: 100%;
+            overflow: hidden;
+          "
+          title="Advertisement"
+        ></iframe>
+      </div>
     </div>
   </body>
 </html>
