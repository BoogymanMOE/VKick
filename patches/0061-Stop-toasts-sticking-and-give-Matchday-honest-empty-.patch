   useEffect(() => {
     const el = ref.current;
     if (!el) return;
     const hide = () => setHidden(true);
     const reward = () => notifyHaptic("success");
     el.addEventListener("reward", reward);
-    el.addEventListener("onError", hide);
+    el.addEventListener("onError", giveUp);
