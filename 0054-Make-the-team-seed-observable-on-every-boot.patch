From eeae852b43ece8febc71da8b963ba172691efd38 Mon Sep 17 00:00:00 2001
From: verkur46 <mohamadrezasahami1999@gmail.com>
Date: Sat, 10 Oct 2026 21:49:16 +0330
Subject: [PATCH 054/230] Make the team seed observable on every boot
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

seedTeams() already runs unconditionally at the end of migrate(), which
getDb() calls on every process start — not only when the SQLite file is
first created — so a persistent-disk database that predates the seed is
seeded on the next deploy too. Make that guarantee explicit and
provable: seedTeams() now reports how many rows it actually inserted and
migrate() logs a one-line summary, so Render's boot logs show
definitively whether the seed ran and how many teams the table holds.

🤖 Generated with Codebuff
Co-Authored-By: Codebuff <noreply@codebuff.com>
---
 server/db/schema.ts    | 13 ++++++++++++-
 server/db/seedTeams.ts | 18 ++++++++++++++++--
 2 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/server/db/schema.ts b/server/db/schema.ts
index b4d4799..46b82ad 100644
--- a/server/db/schema.ts
+++ b/server/db/schema.ts
@@ -785,5 +785,16 @@ export function migrate(db: DatabaseSync): void {
   // run, so Onboarding is never empty on first boot. INSERT OR IGNORE makes it
   // idempotent — the ESPN sync (server/sync/upserts.ts) upsertCoalesces on
   // teams.id, so live data overwrites these labels without clobbering the seed.
-  seedTeams(db);
+  //
+  // NOTE: this call sits at the very end of migrate(), which getDb() runs on
+  // EVERY process boot (there is no "database already exists, skip the seed"
+  // branch). A persistent-disk database created before this seed existed is
+  // therefore seeded on the first deploy after it, not only on a fresh file.
+  // The function logs what it inserted so Render's boot logs can prove it ran.
+  const seeded = seedTeams(db);
+  console.log(
+    seeded > 0
+      ? `[db] team seed inserted ${seeded} missing row(s)`
+      : "[db] team seed: all rows already present (no-op)",
+  );
 }
diff --git a/server/db/seedTeams.ts b/server/db/seedTeams.ts
index af8caf0..2ce1cbb 100644
--- a/server/db/seedTeams.ts
+++ b/server/db/seedTeams.ts
@@ -544,13 +544,27 @@ export const SEED_TEAMS: SeedTeam[] = [
  * Seed the static team roster into the teams table. Safe to call on every
  * migrate() — INSERT OR IGNORE makes it idempotent, and a later ESPN sync
  * upsert can update these rows with live data.
+ *
+ * Returns the number of rows actually INSERTED this call (0 on a restart
+ * against an already-seeded database, >0 the first time a row appears). The
+ * caller logs it so a deploy's Render logs show definitively whether the seed
+ * ran, and migrate() runs it on every boot — NOT only when the file is first
+ * created — so a persistent-disk database that predates this logic still gets
+ * the seed on the next deploy.
  */
-export function seedTeams(db: DatabaseSync): void {
+export function seedTeams(db: DatabaseSync): number {
+  console.log("[db] seeding teams...");
   const stmt = db.prepare(
     `INSERT OR IGNORE INTO teams (id, name, short_name, abbreviation, logo_url, color, league)
      VALUES (?, ?, ?, ?, ?, ?, ?)`,
   );
+  let inserted = 0;
   for (const t of SEED_TEAMS) {
-    stmt.run(t.id, t.name, t.short_name, t.abbreviation, t.logo_url ?? null, t.color, t.league);
+    const res = stmt.run(t.id, t.name, t.short_name, t.abbreviation, t.logo_url ?? null, t.color, t.league);
+    inserted += Number(res.changes ?? 0);
   }
+  console.log("[db] teams seeded:", inserted);
+  const total = Number((db.prepare("SELECT COUNT(*) AS n FROM teams").get() as { n: number }).n);
+  console.log(`[db] teams table now holds ${total} row(s)`);
+  return inserted;
 }
