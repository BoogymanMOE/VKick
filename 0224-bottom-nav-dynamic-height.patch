   const { t } = useI18n();
   const { pathname } = useLocation();
   // A team sub-page belongs to no top-level tab: highlighting one would claim a
@@ -25,6 +26,7 @@ export function TabBar() {
     // imperceptible but ran on every scroll frame.
     // Ad is now inline and scrolls with content, so TabBar sits at the very bottom.
     <nav
+      ref={ref}
       className="pad-safe-bottom fixed bottom-0 left-0 right-0 z-20 border-t border-line bg-base/95"
     >
       <ul className="mx-auto flex w-full max-w-[var(--app-max-width,768px)] items-stretch justify-between px-2 pt-1">
@@ -76,4 +78,4 @@ export function TabBar() {
       </ul>
     </nav>
   );
-}
+});
diff --git a/src/index.css b/src/index.css
index 9fa4856..91ebe1d 100644
--- a/src/index.css
+++ b/src/index.css
@@ -157,7 +157,6 @@
   /* Shared constants — nav height is derived from the fixed sticky header     height (≈69px on real devices); use var() so a single source of truth
      feeds all spacing rules and avoids hardcoded 56px assumptions. */
   :root {
-    --bottom-nav-h: 56px;
   }
 
   /* Safe-area padding helpers — Telegram headers, iPhone home indicator, etc.     The var indirection only exists for share mode: /frame.html embeds the app     in an iframe, and an iframe has no real safe-area insets, so the frame     page supplies --safe-top/--safe-bottom itself (see html[data-embed] below).     Without the variables — every real user, everywhere — the fallback resolves     to exactly the env() value this rule had before. */
