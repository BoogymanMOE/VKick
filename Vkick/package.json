{
  "name": "vkick",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "tsx watch server/index.ts",
    "dev:all": "start cmd /k npm run server && start cmd /k npm run dev",
    "build": "tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "tsx server/cli.ts",
    "sync:dry": "tsx server/cli.ts --dry-run",
    "fetch-logos": "node scripts/fetch-logos.mjs",
    "import-logos": "node scripts/import-logos.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "express": "^5.2.1",
    "grammy": "^1.35.0",
    "node-cron": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.5"
  }
}
