# Server
PORT=8787
# Where the SQLite database file lives (gitignored)
SQLITE_PATH=./data/matchday.db
# Hour in the day (0-23, server local time) for the daily deep sync
SYNC_DAILY_HOUR=4
# How often (seconds) the HEAVY live summary is pulled from ESPN (player
# stats, commentary, boxscore — one call per live match). Stats don't change
# meaningfully faster than this; default 60, floor 15.
LIVE_SUMMARY_SECONDS=60
# The fast lane: how often (seconds) today's scoreboards are swept. One cheap
# call per competition carries every match's score + minute + status — that's
# what makes the app feel live. Default 15, floor 10.
LIVE_PULSE_SECONDS=15
# Comma-separated Telegram user ids that may call admin endpoints (e.g. curating versus pairs); leave empty to disable
ADMIN_TELEGRAM_IDS=
# Optional: fixed secret for dev testing; when set, /api/auth/login accepts "dev:<any-id>" tokens (DO NOT set in production)
DEV_AUTH_SECRET=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
