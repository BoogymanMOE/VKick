# Server
PORT=8787
# Where the SQLite database file lives (gitignored)
SQLITE_PATH=./data/matchday.db
# Hour in the day (0-23, server local time) for the daily deep sync
SYNC_DAILY_HOUR=4
# How often (seconds) the HEAVY live summary is pulled from ESPN (player
# stats, commentary, boxscore — one call per live match). Stats don't change
# meaningfully faster than this; default 60, floor 15.
LIVE_SUMMARY_SECONDS=60
# The fast lane: how often (seconds) today's scoreboards are swept. One cheap
# call per competition carries every match's score + minute + status — that's
# what makes the app feel live. Default 15, floor 10.
LIVE_PULSE_SECONDS=15
# The near-kickoff lane: how often (seconds) a SCHEDULED match within ~90 min
# of kickoff is re-checked so the official-lineup gate opens fast. Default 150,
# floor 60.
NEAR_KICKOFF_SECONDS=150
# Dev/CI escape hatch: set to 1 to boot the API WITHOUT the ESPN sync loops,
# the resolver cron, the bot or the retention sweep (local fixtures stay put).
# Leave empty in production.
SKIP_CRON=
# Comma-separated Telegram user ids that may call admin endpoints (manual sync trigger, single-recipient push); leave empty to disable
ADMIN_TELEGRAM_IDS=
# Optional: fixed secret for dev testing; when set, /api/auth/login accepts "dev:<any-id>" tokens (DO NOT set in production)
DEV_AUTH_SECRET=
# TEMP auth probe: set to 1 while testing on a real Telegram device and every
# /api/auth/guest call logs one line (initData key names + booleans, never the
# data itself). Empty = silent, which is what production wants.
AUTH_PROBE=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the web app — the tunnel URL from start-telegram.bat while
# developing, your production host after deploy. The bot's /start button and
# Mini App menu open this, so it must match what you registered in BotFather.
MINI_APP_URL=

# Data retention: finished matches older than this many days lose their
# detail rows (timeline, commentary, stat sheets, push audit). Match rows,
# teams and standings are never touched. 0 keeps everything forever.
RETENTION_DAYS=120
# Size cap for logs/api.log in KB (rotates once to api.log.1). 0 = uncapped.
RETENTION_LOG_KB=512

# Ads (Telegram Mini App only): the inline Adsgram Task card on Matchday and
# Match detail. Register at https://partner.adsgram.ai, create one Block of
# type Task, put its id here (format: task-12345). Task is Adsgram's only
# inline unit — they ship no banner format. BOTH this and ADGRAM_ENABLED=true
# below are required; unset/empty = ads disabled and the SDK never loads. Set
# both in the Telegram deployment only: the card's Telegram check is the SDK
# script itself, which also loads in a plain browser, so an enabled web
# deployment would render the card there too.
VITE_ADSGRAM_TASK_BLOCK_ID=

# Ads master switch. Must be exactly "true" for any ad to render; anything else
# (unset, "false", "1", "yes") renders none — the Task card returns null before
# it ever touches the SDK. Both names work: this one is read through
# vite.config's define, VITE_ADGRAM_ENABLED is Vite's own client-visible prefix.
# Baked in at BUILD time — flipping it needs a rebuild. See src/lib/ads.ts.
ADGRAM_ENABLED=false
